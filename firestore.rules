rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'soumailaharoune8@gmail.com' ||
        request.auth.token.email == 'admin@bookly.studio' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUser(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 150;
    }

    function isValidProject(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.status is string && data.status.size() <= 50;
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidUser(incoming());
      allow delete: if isAdmin();
    }

    // Ebook Projects
    match /projects/{projectId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(projectId) && incoming().userId == request.auth.uid && isValidProject(incoming());
      allow update: if isSignedIn() && isValidId(projectId) && (resource.data.userId == request.auth.uid || isAdmin()) && isValidProject(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(projectId) && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Global Admin Config
    match /admin_config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Health check connectivity probe
    match /test/{testId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
